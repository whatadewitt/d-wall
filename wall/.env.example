# Copy to .env (git-ignored) and fill in. Never commit real values.

# LAN address of the media server. docker-compose publishes port 9600 on this address only.
WALL_BIND_ADDR=192.168.1.10

# Fully Kiosk Remote Admin password (milestone 0).
FULLY_KIOSK_PASSWORD=

# Path on the media server to the Google service account key (milestone 1). Keep it outside the repo.
# The container runs as uid 1000, so the file must be readable by that uid.
GOOGLE_SA_KEY_FILE=/home/you/wall-secrets/google-service-account.json

# The local view-only UniFi Protect user (milestone 2): finds each camera's medium and low streams
# and serves Protect snapshots.
PROTECT_USERNAME=
PROTECT_PASSWORD=

# Shared secret for the Protect Alarm Manager webhook (milestone 3). Protect sends it in the
# X-Doorbell-Secret header. Make one with: openssl rand -hex 32
DOORBELL_WEBHOOK_SECRET=

# Folder of idle-screen photos on the media server (milestone 4). Defaults to wall/photos.
# PHOTOS_DIR=/home/you/wall-photos

# Later milestones:
# IMMICH_API_KEY=
