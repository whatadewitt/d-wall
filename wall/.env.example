# Copy to .env (git-ignored) and fill in. Never commit real values.

# LAN address of the media server. docker-compose publishes port 9600 on this address only.
WALL_BIND_ADDR=192.168.1.10

# Fully Kiosk Remote Admin password (milestone 0).
FULLY_KIOSK_PASSWORD=

# Later milestones (unused in milestone 0):
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
PROTECT_USERNAME=
PROTECT_PASSWORD=
DOORBELL_WEBHOOK_SECRET=
# IMMICH_API_KEY=
